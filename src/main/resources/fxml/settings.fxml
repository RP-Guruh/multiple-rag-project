<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="18.0" xmlns="http://javafx.com/javafx/23"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="id.guruh.devlablm.ui.controller.SettingsController">

    <!-- Header Page -->
    <VBox spacing="4.0">
        <Label styleClass="title-2" text="Pengaturan &amp; Tema AtlantaFX" />
        <Label styleClass="text-muted" text="Konfigurasi preferensi tampilan antarmuka aplikasi." />
    </VBox>

    <VBox spacing="14.0" styleClass="card">
        <padding>
            <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
        </padding>
        <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <FontIcon iconLiteral="mdmz-palette" iconSize="20" />
                <Label styleClass="title-4" text="Pilihan Tema Tampilan" />
            </HBox>

            <Label styleClass="text-muted" text="Pilih salah satu tema modern AtlantaFX:" />

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <ComboBox fx:id="themeComboBox" prefWidth="250.0" />
            </HBox>
        </children>
    </VBox>

</VBox>
