<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox prefHeight="780.0" prefWidth="1180.0" spacing="0.0" style="-fx-background-color: -color-bg-default;"
      xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="id.guruh.devlablm.ui.controller.ProjectDetailController">

    <!-- Header bar -->
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="project-detail-header">
        <FontIcon iconLiteral="mdal-description" iconSize="30" />
        <VBox spacing="2.0">
            <Label fx:id="lblHeaderTitle" styleClass="title-2, text-bold" text="Project Details" />
            <Label fx:id="lblHeaderSubtitle" styleClass="text-muted, text-small"
                   text="Configure project metadata, system prompt, knowledge base, and vector embeddings" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnHeaderTrain" onAction="#onStartTraining" styleClass="success" text="Start Training">
            <graphic>
                <FontIcon iconLiteral="mdmz-model_training" iconSize="16" />
            </graphic>
        </Button>
    </HBox>

    <!-- Main Split Layout -->
    <SplitPane dividerPositions="0.36" VBox.vgrow="ALWAYS">
        <!-- Left Panel: Project Settings & System Prompt -->
        <VBox spacing="14.0">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
            <VBox spacing="12.0" styleClass="detail-card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <FontIcon iconLiteral="mdmz-tune" iconSize="18" />
                    <Label styleClass="title-4, text-bold" text="Project &amp; Prompt Settings" />
                </HBox>
                <Separator />

                <VBox spacing="6.0">
                    <Label styleClass="text-bold" text="Project Name" />
                    <TextField fx:id="nameField" promptText="Enter project name..." />
                </VBox>

                <VBox spacing="6.0">
                    <Label styleClass="text-bold" text="Description" />
                    <TextArea fx:id="descriptionArea" prefRowCount="3" promptText="Describe the project scope and retrieval objectives..." wrapText="true" />
                </VBox>

                <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="text-bold" text="System Prompt" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="text-muted, text-small" text="Persona &amp; Rules" />
                    </HBox>
                    <TextArea fx:id="systemPromptArea" prefRowCount="11" promptText="Example:&#10;You are a customer support AI assistant.&#10;Answer user questions strictly based on the provided knowledge base context.&#10;If the context does not contain the answer, politely state that the information is unavailable." styleClass="prompt-area" wrapText="true" VBox.vgrow="ALWAYS" />
                    <Label styleClass="text-muted, text-small" text="💡 The system prompt defines AI persona and behavior before RAG document context is injected." wrapText="true" />
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Label fx:id="lblSaveStatus" styleClass="text-muted, text-small" />
                    <Button fx:id="btnSaveLeft" onAction="#onSaveProject" styleClass="accent" text="Save Changes">
                        <graphic>
                            <FontIcon iconLiteral="mdmz-save" iconSize="16" />
                        </graphic>
                    </Button>
                </HBox>
            </VBox>
        </VBox>

        <!-- Right Panel: Knowledge Base, Document List & Training Pipeline -->
        <VBox spacing="14.0">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>

            <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <!-- TAB 1: Knowledge Base Documents -->
                <Tab text="Knowledge Base">
                    <graphic>
                        <FontIcon iconLiteral="mdal-cloud_upload" iconSize="16" />
                    </graphic>
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                        <VBox spacing="14.0">
                            <padding>
                                <Insets bottom="12.0" left="12.0" right="12.0" top="14.0" />
                            </padding>

                            <!-- Document Upload Card -->
                            <VBox spacing="12.0" styleClass="detail-card">
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <FontIcon iconLiteral="mdal-cloud_upload" iconSize="18" />
                                    <Label styleClass="title-4, text-bold" text="Upload Documents" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label styleClass="text-muted, text-small" text="Supported: PDF, Excel, Word, Text" />
                                </HBox>

                                <!-- Dropzone Box -->
                                <VBox fx:id="dropZone" alignment="CENTER" onMouseClicked="#onBrowseFiles" spacing="8.0" styleClass="dropzone">
                                    <FontIcon iconLiteral="mdal-cloud_upload" iconSize="36" />
                                    <Label styleClass="text-bold" text="Drag and drop documents here, or click to browse" />
                                    <Label styleClass="text-muted, text-small" text="Supported formats:" />
                                    <HBox alignment="CENTER" spacing="8.0">
                                        <Label styleClass="badge-tag, badge-pdf" text="PDF (.pdf)" />
                                        <Label styleClass="badge-tag, badge-word" text="Word (.docx, .doc)" />
                                        <Label styleClass="badge-tag, badge-excel" text="Excel (.xlsx, .xls)" />
                                        <Label styleClass="badge-tag, badge-text" text="Plain Text (.txt, .md, .csv)" />
                                    </HBox>
                                    <Button fx:id="btnBrowseFiles" onAction="#onBrowseFiles" text="Browse Files...">
                                        <graphic>
                                            <FontIcon iconLiteral="mdal-folder_open" iconSize="16" />
                                        </graphic>
                                    </Button>
                                </VBox>

                                <!-- Queue List -->
                                <VBox fx:id="queueContainer" managed="false" spacing="8.0" visible="false">
                                    <Label styleClass="text-bold, text-small" text="Selected Files Ready for Upload:" />
                                    <ListView fx:id="queueListView" prefHeight="90.0" />
                                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                        <Button fx:id="btnClearQueue" onAction="#onClearQueue" text="Clear Selection" />
                                        <Button fx:id="btnUploadQueue" onAction="#onUploadQueue" styleClass="accent" text="Upload to Knowledge Base">
                                            <graphic>
                                                <FontIcon iconLiteral="mdal-file_upload" iconSize="16" />
                                            </graphic>
                                        </Button>
                                    </HBox>
                                </VBox>

                                <Label fx:id="lblUploadFeedback" styleClass="text-muted, text-small" />
                            </VBox>

                            <!-- Document Table Card -->
                            <VBox spacing="12.0" styleClass="detail-card">
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <FontIcon iconLiteral="mdal-history" iconSize="18" />
                                    <Label styleClass="title-4, text-bold" text="Indexed Documents" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="searchDocField" prefWidth="180.0" promptText="Search documents..." />
                                    <ComboBox fx:id="typeFilterCombo" prefWidth="130.0" />
                                    <Button fx:id="btnRefreshTable" onAction="#onRefreshTable">
                                        <graphic>
                                            <FontIcon iconLiteral="mdmz-refresh" iconSize="16" />
                                        </graphic>
                                    </Button>
                                </HBox>

                                <TableView fx:id="knowledgeTable" prefHeight="230.0">
                                    <columns>
                                        <TableColumn fx:id="colFileName" prefWidth="240.0" text="Document Name" />
                                        <TableColumn fx:id="colFileType" prefWidth="80.0" text="Format" />
                                        <TableColumn fx:id="colFileSize" prefWidth="80.0" text="Size" />
                                        <TableColumn fx:id="colChunkCount" prefWidth="105.0" text="Vector Chunks" />
                                        <TableColumn fx:id="colUploadedAt" prefWidth="135.0" text="Uploaded At" />
                                        <TableColumn fx:id="colStatus" prefWidth="110.0" text="Status" />
                                    </columns>
                                </TableView>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label fx:id="lblKnowledgeSummary" styleClass="text-muted, text-small"
                                           text="Total: 4 Documents | 428 Vector Chunks | Last Trained: Nov 06, 2026 14:30" />
                                    <Region HBox.hgrow="ALWAYS" />
                                </HBox>
                            </VBox>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- TAB 2: Training & Embeddings Pipeline -->
                <Tab text="Training &amp; Embeddings">
                    <graphic>
                        <FontIcon iconLiteral="mdmz-model_training" iconSize="16" />
                    </graphic>
                    <VBox spacing="14.0">
                        <padding>
                            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                        </padding>

                        <VBox spacing="12.0" styleClass="detail-card">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <FontIcon iconLiteral="mdmz-model_training" iconSize="32" />
                                <VBox spacing="3.0">
                                    <Label styleClass="title-4, text-bold" text="RAG Training &amp; Embedding Pipeline" />
                                    <Label styleClass="text-muted, text-small"
                                           text="Extracts document text, splits content into semantic chunks, generates vector embeddings, and indexes into pgvector." />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnTabStartTraining" onAction="#onStartTraining" prefHeight="38.0" styleClass="success" text="Start Training">
                                    <graphic>
                                        <FontIcon iconLiteral="mdmz-model_training" iconSize="18" />
                                    </graphic>
                                </Button>
                            </HBox>
                            <Separator />
                            <VBox spacing="8.0">
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label styleClass="text-bold" text="Pipeline Status:" />
                                    <Label fx:id="lblTrainingStatusBadge" styleClass="badge-status-trained" text="Ready" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblTrainingPercent" styleClass="text-muted, text-small" text="0%" />
                                </HBox>
                                <ProgressBar fx:id="trainingProgressBar" maxWidth="Infinity" progress="0.0" />
                            </VBox>
                        </VBox>

                        <VBox spacing="8.0" styleClass="detail-card" VBox.vgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label styleClass="text-bold" text="Extraction &amp; Embedding Activity Log" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnClearLog" onAction="#onClearLog" text="Clear Log" />
                            </HBox>
                            <TextArea fx:id="logConsoleArea" editable="false" prefRowCount="12" styleClass="console-log" wrapText="true" VBox.vgrow="ALWAYS" />
                        </VBox>
                    </VBox>
                </Tab>
            </TabPane>
        </VBox>
    </SplitPane>
</VBox>