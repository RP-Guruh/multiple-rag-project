<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" xmlns="http://javafx.com/javafx/23"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="id.guruh.devlablm.ui.controller.DashboardController">

    <VBox spacing="4.0">
        <Label styleClass="title-2" text="Dashboard" />
        <Label styleClass="text-muted" text="Manage your chatbot projects and train them with new knowledge." />
    </VBox>

    <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="cards-area">
        <GridPane fx:id="cardGrid" hgap="16" vgap="16" styleClass="cards-grid">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
        </GridPane>
    </ScrollPane>

</VBox>
